{
    "name": "phpclaw/phpclaw-drupal",
    "description": "phpClaw adapter for Drupal 10/11. Module, Drush commands, admin UI, 22 tools.",
    "homepage": "https://phpclaw.ai",
    "type": "drupal-module",
    "license": "MIT",
    "archive": {
        "exclude": [
            "/tests",
            "/benchmarks",
            "/.phpbench",
            "/phpunit.xml",
            "/phpstan.neon",
            "/pint.json",
            "/phpbench.json",
            "/.editorconfig",
            "/.phpunit.result.cache",
            "/vendor",
            "/composer.lock",
            "/.gitignore",
            "/.gitattributes"
        ]
    },
    "keywords": [
        "phpclaw",
        "drupal",
        "drupal10",
        "drupal11",
        "ai",
        "agent",
        "llm",
        "anthropic",
        "openai",
        "ollama",
        "tools",
        "drush"
    ],
    "authors": [
        {
            "name": "Akash Patel",
            "email": "er.akashpatel1908@gmail.com",
            "homepage": "https://phpclaw.ai"
        }
    ],
    "require": {
        "php": "^8.1",
        "composer-runtime-api": "^2.0",
        "phpclaw/phpclaw": "^0.1",
        "phpclaw/phpclaw-cloud": "^0.1",
        "phpclaw/phpclaw-mcp": "^0.1",
        "drupal/core": "^10.0|^11.0"
    },
    "support": {
        "issues": "https://github.com/phpclaw-php/phpclaw-monorepo/issues",
        "source": "https://github.com/phpclaw-php/phpclaw-monorepo",
        "docs": "https://phpclaw.ai/docs"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^1.10",
        "phpbench/phpbench": "^1.6",
        "mglaman/phpstan-drupal": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "PhpClaw\\Drupal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpClaw\\Drupal\\Tests\\": "tests/src/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml --testsuite=Unit",
        "test:kernel": "phpunit --configuration phpunit.xml --testsuite=Kernel",
        "test:coverage": "phpunit --configuration phpunit.xml --testsuite=Unit --coverage-text",
        "lint": "pint",
        "analyse": "phpstan analyse",
        "sync-core": "composer reinstall phpclaw/phpclaw phpclaw/phpclaw-cloud phpclaw/phpclaw-mcp"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": false,
                "versions": {
                    "phpclaw/phpclaw": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../cloud",
            "options": {
                "symlink": false,
                "versions": {
                    "phpclaw/phpclaw-cloud": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../mcp",
            "options": {
                "symlink": false,
                "versions": {
                    "phpclaw/phpclaw-mcp": "0.1.0"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": false,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.3"
        }
    },
    "extra": {
        "drupal": {
            "version": "^10.0|^11.0"
        }
    }
}
