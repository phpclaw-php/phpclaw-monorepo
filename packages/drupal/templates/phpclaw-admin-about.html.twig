<div class="phpclaw-admin-page">

  <div class="phpclaw-about-hero">
    <h1 class="phpclaw-about-hero-title">phpClaw</h1>
    <p class="phpclaw-about-hero-subtitle">Universal AI agent engine for Drupal</p>
    <p class="phpclaw-about-hero-version">Version {{ version }}</p>
    <div class="phpclaw-about-hero-buttons">
      <a href="https://phpclaw.ai" target="_blank" rel="noopener" class="phpclaw-btn-hero-primary">phpclaw.ai</a>
      <a href="https://phpclaw.ai/docs" target="_blank" rel="noopener" class="phpclaw-btn-hero-ghost">Documentation</a>
      <a href="https://github.com/phpclaw-php/phpclaw" target="_blank" rel="noopener" class="phpclaw-btn-hero-ghost">GitHub</a>
    </div>
  </div>

  <div class="phpclaw-content-panel">
    <h2 class="phpclaw-section-title">What is phpClaw?</h2>
    <p class="phpclaw-body-text">phpClaw is an AI assistant that lives inside your Drupal admin. Connect any AI provider, whether Anthropic Claude, OpenAI GPT, Groq, Google Gemini, Mistral, DeepSeek, Ollama (local), or any Custom OpenAI-compatible endpoint, then ask questions about your site in plain English.</p>
    <p class="phpclaw-body-text">No SQL to write. No dashboards to learn. Just ask: <em>"Any unpublished content?"</em>, <em>"Recent errors in watchdog?"</em>, <em>"Show users with admin role"</em>, and get real answers from real site data.</p>
    <p class="phpclaw-body-text">Part of the phpClaw ecosystem, the same AI engine available for Laravel, WordPress, Joomla, Magento, and other PHP frameworks and CMS platforms.</p>
  </div>

  <h2 class="phpclaw-section-title phpclaw-section-title--features">Built-in features</h2>
  <div class="phpclaw-feature-grid">
    {% set features = [
      {'icon': '&#129302;', 'title': '8 AI Providers',             'text': 'Anthropic Claude, OpenAI GPT, Groq, Google Gemini, Mistral, DeepSeek, Ollama (local), Custom (any OpenAI-compatible endpoint). Switch from Settings with zero code changes.'},
      {'icon': '&#128736;',  'title': 'Drupal tools + 7 core utility', 'text': '15 Drupal-native tools (Entity, Views, Blocks, Cache, Config, Cron, Media, Menus, Modules, Webforms, Path Aliases, User Roles, Content Moderation, Database, Logs) plus 7 core utility tools (HTTP, Shell, FileRead, FileEdit, FileWrite, CodeSearch, ProjectInfo).'},
      {'icon': '&#128172;', 'title': 'Chat UI',                    'text': 'Chat-style interface in the admin panel. Multi-turn conversation history, searchable sidebar. Ask anything.'},
      {'icon': '&#9889;',   'title': 'Live Tool Streaming',        'text': 'Server-Sent Events stream tool calls and assistant tokens as they happen. Spinner placeholders swap to typed result cards the moment data arrives.'},
      {'icon': '&#128268;', 'title': 'REST API',                   'text': 'POST endpoint: integrate the AI agent into any frontend or external service.'},
      {'icon': '&#128421;',  'title': 'Drush CLI',                  'text': 'drush phpclaw:run "your prompt" sends prompts from the terminal. Script automations, run in cron, or pipe output.'},
      {'icon': '&#128274;', 'title': 'Production-Grade Security',  'text': 'Multi-layered protection against prompt injection, unsafe commands, and data leakage. Your data stays safe.'},
      {'icon': '&#127970;', 'title': 'Extensible by Design',       'text': 'Add your own tools, guards, hooks, and skills via Drupal tagged services, with no core changes required.'}
    ] %}
    {% for f in features %}
    <div class="phpclaw-feature-card">
      <div class="phpclaw-feature-icon">{{ f.icon|raw }}</div>
      <strong class="phpclaw-feature-title">{{ f.title }}</strong>
      <p class="phpclaw-feature-text">{{ f.text }}</p>
    </div>
    {% endfor %}
  </div>

  <div class="phpclaw-content-panel">
    <h2 class="phpclaw-section-title">Installable packages</h2>
    <p class="phpclaw-body-text">MIT-licensed. Available as separate Composer packages:</p>
    <table class="table table-bordered table-striped phpclaw-table">
      <thead>
        <tr><th class="phpclaw-th-pkg">Package</th><th>What it adds</th><th>Installed</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><code>phpclaw/phpclaw</code></td>
          <td>Core AI agent engine: providers, tools, guards, hooks, memory, skills all included. Powers every phpClaw adapter.</td>
          <td>{{ has_core ? '✓' : '✗' }}</td>
        </tr>
        <tr>
          <td><code>phpclaw/phpclaw-drupal</code></td>
          <td>This module.</td>
          <td>✓</td>
        </tr>
        <tr>
          <td><code>phpclaw/phpclaw-cloud</code></td>
          <td>Cloud transport: lifecycle event forwarding and webhook delivery to the phpClaw Cloud service.</td>
          <td>{{ has_cloud ? '✓' : '✗' }}</td>
        </tr>
        <tr>
          <td><code>phpclaw/phpclaw-mcp</code></td>
          <td>MCP server: expose your tools to Claude Desktop, Cursor, and other MCP clients.</td>
          <td>{{ has_mcp ? '✓' : '✗' }}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="phpclaw-community">
    <div class="phpclaw-community-inner">
      <h4 class="phpclaw-community-title">Need more? phpClaw Enterprise</h4>
      <p class="phpclaw-community-text">phpClaw is open source under the MIT license. One engine for the entire PHP ecosystem.</p>
      <p class="phpclaw-community-text">Looking for custom AI tools tailored to your site? Need to integrate phpClaw with your CRM, ERP, or internal systems? phpClaw Enterprise offers dedicated support, custom tool development, and managed onboarding.</p>
      <div class="phpclaw-community-buttons">
        <a href="https://github.com/phpclaw-php/phpclaw" target="_blank" rel="noopener" class="phpclaw-btn-github">&#9733; Star on GitHub</a>
        <a href="https://packagist.org/packages/phpclaw/phpclaw" target="_blank" rel="noopener" class="phpclaw-btn-packagist">&#128230; View on Packagist</a>
      </div>
      <div class="phpclaw-community-footer">
        <span>Need custom AI tools for your project?</span>
        <a href="https://phpclaw.ai/enterprise" target="_blank" rel="noopener">&rarr; phpclaw.ai/enterprise</a>
      </div>
    </div>
  </div>

</div>
