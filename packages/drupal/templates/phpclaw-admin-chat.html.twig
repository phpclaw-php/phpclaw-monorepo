<div class="phpclaw-chat-wrap">

  <div class="phpclaw-chat-sidebar">
    <div class="phpclaw-chat-sidebar-top">
      <button id="phpclaw-new-chat" class="phpclaw-btn phpclaw-btn--primary phpclaw-chat-btn-full">+ {{ 'New Chat'|t }}</button>
      <input id="phpclaw-conv-search" class="phpclaw-input phpclaw-chat-search" type="search" placeholder="{{ 'Search conversations…'|t }}" />
    </div>
    <div id="phpclaw-conv-list" class="phpclaw-chat-conv-list">
      {% if conversations is empty %}
        <p id="phpclaw-empty-sidebar" class="phpclaw-meta phpclaw-chat-empty-sidebar">{{ 'No conversations yet.'|t }}<br>{{ 'Send a message to start.'|t }}</p>
      {% else %}
        {% for cid, conv in conversations %}
          <div class="phpclaw-conv-item{{ cid == init_conv_id ? ' active' : '' }}" data-conv-id="{{ cid }}" data-title="{{ conv.display|lower }}">
            <div class="phpclaw-conv-item-title">{{ conv.display }}</div>
            <div class="phpclaw-conv-item-bottom">
              <span class="phpclaw-conv-item-time">{{ conv.when }}</span>
              <button type="button" class="phpclaw-conv-delete" data-conv-id="{{ cid }}" title="{{ 'Delete'|t }}">&#10005;</button>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>

  <div class="phpclaw-chat-main">
    <div id="phpclaw-chat-header" class="phpclaw-chat-header">{{ init_title }}</div>

    <div id="phpclaw-messages" class="phpclaw-chat-messages">
      {{ init_messages_html|raw }}
    </div>

    <div class="phpclaw-chat-input-area">
      <div class="phpclaw-chat-input-row">
        <textarea id="phpclaw-message" rows="2" placeholder="{{ 'Message phpClaw… (Enter to send, Shift+Enter for new line)'|t }}"></textarea>
        <button id="phpclaw-send-btn" type="button" title="{{ 'Send (Enter)'|t }}">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
        </button>
      </div>
      <div id="phpclaw-input-meta" class="phpclaw-chat-input-meta">{% if provider %}{{ provider|capitalize }}{% if model %} · {{ model }}{% endif %} · {% endif %}{{ 'Responses are AI-generated. Verify before acting.'|t }}</div>
    </div>
  </div>

</div>

<div class="phpclaw-community">
  <div class="phpclaw-community-inner">
    <h4 class="phpclaw-community-title">Built for the PHP community</h4>
    <p class="phpclaw-community-text">phpClaw is open source under the MIT license.</p>
    <p class="phpclaw-community-text">One engine for the entire PHP ecosystem.</p>
    <div class="phpclaw-community-buttons">
      <a href="https://github.com/phpclaw-php/phpclaw" target="_blank" rel="noopener" class="phpclaw-btn-github">&#9733; Star on GitHub</a>
      <a href="https://packagist.org/packages/phpclaw/phpclaw" target="_blank" rel="noopener" class="phpclaw-btn-packagist">&#128230; View on Packagist</a>
    </div>
    <div class="phpclaw-community-footer">
      <span>Need custom AI tools for your project?</span>
      <a href="https://phpclaw.ai/enterprise" target="_blank" rel="noopener">&rarr; phpclaw.ai/enterprise</a>
    </div>
  </div>
</div>
