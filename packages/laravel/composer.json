{
    "name": "phpclaw/phpclaw-laravel",
    "description": "phpClaw adapter for Laravel. Add AI agents to any Laravel app with a single composer require.",
    "homepage": "https://phpclaw.ai",
    "type": "library",
    "license": "MIT",
    "archive": {
        "exclude": [
            "/tests",
            "/benchmarks",
            "/.phpbench",
            "/phpbench.json",
            "/phpunit.xml",
            "/.phpunit.result.cache",
            "/.phan",
            "/phpstan.neon",
            "/pint.json",
            "/vendor",
            "/composer.lock",
            "/.gitignore",
            "/.gitattributes",
            "/stubs"
        ]
    },
    "keywords": [
        "ai",
        "agent",
        "llm",
        "laravel",
        "anthropic",
        "openai",
        "phpclaw"
    ],
    "authors": [
        {
            "name": "Akash Patel",
            "email": "er.akashpatel1908@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "phpclaw/phpclaw": "^0.1",
        "phpclaw/phpclaw-cloud": "^0.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/bus": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "phpclaw/phpclaw-mcp": "^0.1"
    },
    "support": {
        "issues": "https://github.com/phpclaw-php/phpclaw-monorepo/issues",
        "source": "https://github.com/phpclaw-php/phpclaw-monorepo",
        "docs": "https://phpclaw.ai/docs"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "laravel/pint": "^1.0",
        "phpbench/phpbench": "^1.6",
        "phpstan/phpstan": "^1.0 || ^2.0",
        "larastan/larastan": "^2.9 || ^3.0"
    },
    "suggest": {
        "laravel/telescope": "Records phpClaw agent runs, tool calls, and guard blocks in the Telescope dashboard for local debugging (^4.0|^5.0)."
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "analyse": "phpstan analyse",
        "sync-core": "composer reinstall phpclaw/phpclaw phpclaw/phpclaw-cloud phpclaw/phpclaw-mcp"
    },
    "autoload": {
        "psr-4": {
            "PhpClaw\\Laravel\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PhpClaw\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PhpClaw\\Laravel\\PhpClawServiceProvider"
            ],
            "aliases": {
                "PhpClaw": "PhpClaw\\Laravel\\Facades\\PhpClaw"
            }
        }
    },
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": false,
                "versions": {
                    "phpclaw/phpclaw": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../cloud",
            "options": {
                "symlink": false,
                "versions": {
                    "phpclaw/phpclaw-cloud": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../mcp",
            "options": {
                "symlink": false,
                "versions": {
                    "phpclaw/phpclaw-mcp": "0.1.0"
                }
            }
        }
    ],
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3"
        },
        "policy": {
            "advisories": {
                "ignore": ["laravel/framework"]
            }
        }
    }
}
