{
    "name": "phpclaw/phpclaw-mcp",
    "description": "MCP (Model Context Protocol) server adapter for phpClaw. Expose any PHP app's tools to Claude Desktop, Claude Code, Cursor, and other MCP clients.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ai",
        "agent",
        "mcp",
        "model-context-protocol",
        "llm",
        "php",
        "anthropic",
        "claude",
        "phpclaw"
    ],
    "authors": [
        {
            "name": "Akash Patel",
            "email": "er.akashpatel1908@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "phpclaw/phpclaw": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "PhpClaw\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpClaw\\Mcp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --no-coverage",
        "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-text",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress"
    },
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": false,
                "versions": {
                    "phpclaw/phpclaw": "0.1.0"
                }
            }
        }
    ],
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3"
        }
    }
}
