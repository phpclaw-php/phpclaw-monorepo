{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        {% if can_manage_all %}<a href="{{ url_settings }}" class="btn btn-secondary"><i class="fa fa-cog"></i> Settings</a>{% endif %}
        <a href="{{ url_debug }}" class="btn btn-secondary"><i class="fa fa-comments"></i> Chat</a>
        <a href="{{ url_analytics }}" class="btn btn-primary"><i class="fa fa-bar-chart"></i> Analytics</a>
        <a href="{{ url_guide }}" class="btn btn-secondary"><i class="fa fa-book"></i> Guide</a>
        <a href="{{ url_about }}" class="btn btn-secondary"><i class="fa fa-info-circle"></i> About</a>
      </div>
      <h1>{{ heading_title }}</h1>
    </div>
  </div>

  <div class="container-fluid">

    <div class="phpclaw-stats-grid">
      <div class="phpclaw-stat-card">
        <div class="stat-value">{{ stats.conversations }}</div>
        <div class="stat-label">Conversations</div>
        <div class="stat-detail">{% if can_manage_all %}Total stored{% else %}Yours, stored{% endif %}</div>
      </div>
      <div class="phpclaw-stat-card">
        <div class="stat-value">{{ stats.messages }}</div>
        <div class="stat-label">Messages</div>
        <div class="stat-detail">{% if can_manage_all %}All{% else %}Yours{% endif %}, incl. tool-call rows</div>
      </div>
      <div class="phpclaw-stat-card">
        <div class="stat-value">{{ stats.active_24h }}</div>
        <div class="stat-label">Active 24h</div>
        <div class="stat-detail">{% if can_manage_all %}Conversations{% else %}Your conversations{% endif %} updated in last 24 hours</div>
      </div>
    </div>

    {% include 'extension/phpclaw/admin/view/template/module/phpclaw_community.twig' %}
  </div>
</div>
{{ footer }}
