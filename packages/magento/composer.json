{
    "name": "phpclaw/phpclaw-magento",
    "description": "phpClaw adapter for Magento 2 / Adobe Commerce. Module, CLI command, ResourceConnection memory.",
    "homepage": "https://phpclaw.ai",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": [
        "ai",
        "agent",
        "llm",
        "magento",
        "adobe-commerce",
        "phpclaw",
        "anthropic",
        "openai"
    ],
    "authors": [
        {
            "name": "Akash Patel",
            "email": "er.akashpatel1908@gmail.com",
            "homepage": "https://phpclaw.ai"
        }
    ],
    "require": {
        "php": "^8.1",
        "phpclaw/phpclaw": "^0.1",
        "phpclaw/phpclaw-cloud": "^0.1",
        "phpclaw/phpclaw-mcp": "^0.1"
    },
    "support": {
        "issues": "https://github.com/phpclaw-php/phpclaw-monorepo/issues",
        "source": "https://github.com/phpclaw-php/phpclaw-monorepo",
        "docs": "https://phpclaw.ai/docs"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "laravel/pint": "^1.0",
        "doctrine/instantiator": "~2.0.0",
        "symfony/console": "^5.4|^6.0|^7.0",
        "phpbench/phpbench": "^1.6",
        "phpstan/phpstan": "^1.0 || ^2.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "PhpClaw\\Magento\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpClaw\\Magento\\Tests\\": "tests/"
        }
    },
    "extra": {
        "map": [
            [
                "*",
                "app/code/PhpClaw/Magento"
            ]
        ]
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:coverage": "phpunit --configuration phpunit.xml --coverage-text",
        "lint": "pint",
        "analyse": "phpstan analyse",
        "sync-core": "composer reinstall phpclaw/phpclaw phpclaw/phpclaw-cloud phpclaw/phpclaw-mcp"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": false,
                "versions": {
                    "phpclaw/phpclaw": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../cloud",
            "options": {
                "symlink": false,
                "versions": {
                    "phpclaw/phpclaw-cloud": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../mcp",
            "options": {
                "symlink": false,
                "versions": {
                    "phpclaw/phpclaw-mcp": "0.1.0"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3"
        }
    }
}
