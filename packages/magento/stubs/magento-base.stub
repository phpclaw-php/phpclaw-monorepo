namespace Magento\Backend\App {
    class Action
    {
        protected \Magento\Framework\Message\ManagerInterface $messageManager;

        public function __construct(\Magento\Backend\App\Action\Context $context)
        {
            $this->messageManager = new class implements \Magento\Framework\Message\ManagerInterface {
                public function addSuccessMessage(string $message, string $group = ''): static { return $this; }
                public function addErrorMessage(string $message, string $group = ''): static { return $this; }
                public function addWarningMessage(string $message, string $group = ''): static { return $this; }
                public function addNoticeMessage(string $message, string $group = ''): static { return $this; }
            };
        }

        protected function _isAllowed(): bool
        {
            return true;
        }

        public function getUrl(string $route = '', array $params = []): string
        {
            return '';
        }

        public function getRequest(): \Magento\Framework\App\RequestInterface
        {
            return new class implements \Magento\Framework\App\RequestInterface {
                public function getParam(string $key, mixed $defaultValue = null): mixed { return $defaultValue; }
                public function setParam(string $key, mixed $value): static { return $this; }
                public function getContent(): string|false { return ''; }
                public function getMethod(): string { return 'GET'; }
                public function has(string $key): bool { return false; }
            };
        }

        public function getResponse(): \Magento\Framework\App\ResponseInterface
        {
            return new class implements \Magento\Framework\App\ResponseInterface {};
        }

        public function _processUrlKeys(): bool
        {
            return true;
        }

        public function _redirect(string $path, array $arguments = []): void {}
    }
}

