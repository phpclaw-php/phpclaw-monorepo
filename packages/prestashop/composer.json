{
    "name": "phpclaw/phpclaw-prestashop",
    "description": "AI assistant module for PrestaShop 8 and 9: chat UI, 14 tools, REST API, CLI, 8 AI providers",
    "homepage": "https://phpclaw.ai",
    "type": "prestashop-module",
    "license": "MIT",
    "keywords": [
        "ai",
        "agent",
        "llm",
        "prestashop",
        "phpclaw",
        "anthropic",
        "openai",
        "chatgpt"
    ],
    "authors": [
        {
            "name": "Akash Patel",
            "email": "er.akashpatel1908@gmail.com",
            "homepage": "https://phpclaw.ai"
        }
    ],
    "require": {
        "php": "^8.1",
        "phpclaw/phpclaw": "^0.1",
        "phpclaw/phpclaw-cloud": "^0.1",
        "phpclaw/phpclaw-mcp": "^0.1"
    },
    "support": {
        "issues": "https://github.com/phpclaw-php/phpclaw-monorepo/issues",
        "source": "https://github.com/phpclaw-php/phpclaw-monorepo",
        "docs": "https://phpclaw.ai/docs"
    },
    "autoload": {
        "psr-4": {
            "PhpClaw\\PrestaShop\\": "upload/modules/phpclaw/src/"
        },
        "files": [
            "upload/modules/phpclaw/src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PhpClaw\\PrestaShop\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^1.0 || ^2.0",
        "mockery/mockery": "^1.5",
        "phpbench/phpbench": "^1.6"
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "test:coverage": "phpunit",
        "lint": "pint",
        "analyse": "phpstan analyse",
        "sync-core": "composer reinstall phpclaw/phpclaw phpclaw/phpclaw-cloud phpclaw/phpclaw-mcp"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": false,
                "versions": {
                    "phpclaw/phpclaw": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../cloud",
            "options": {
                "symlink": false,
                "versions": {
                    "phpclaw/phpclaw-cloud": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../mcp",
            "options": {
                "symlink": false,
                "versions": {
                    "phpclaw/phpclaw-mcp": "0.1.0"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3"
        }
    }
}
