namespace Joomla\Database {
    interface QueryInterface {
        public function select(mixed $columns): static;
        public function from(mixed $tables): static;
        public function where(mixed $conditions, string $glue = 'AND'): static;
        public function order(mixed $columns): static;
        public function delete(?string $table = null): static;
        public function update(string $table): static;
        public function insert(string $table, bool $incrementField = false): static;
        public function columns(mixed $columns): static;
        public function values(string $values): static;
        public function set(mixed $conditions, string $glue = ','): static;
        public function innerJoin(string $condition): static;
        public function join(string $type, string $conditions): static;
        public function bind(mixed $key, mixed &$value, mixed $dataType = null): static;
        public function clear(?string $clause = null): static;
        public function setLimit(int $limit = 0, int $offset = 0): static;
    }
}

namespace Joomla\CMS\Extension\Service\Provider {
    class MVCFactory implements \Joomla\DI\ServiceProviderInterface
    {
        public function __construct(string $namespace) {}
        public function register(\Joomla\DI\Container $container) {}
    }
    class ComponentDispatcherFactory implements \Joomla\DI\ServiceProviderInterface
    {
        public function __construct(string $namespace) {}
        public function register(\Joomla\DI\Container $container) {}
    }
}

namespace Joomla\CMS\Dispatcher {
    interface ComponentDispatcherFactoryInterface
    {
        public function createDispatcher(\Joomla\CMS\Application\CMSApplication $application, mixed $input = null): \Joomla\Event\DispatcherInterface;
    }
}

namespace Joomla\CMS\Installer {
    abstract class InstallerAdapter
    {
        public function getElement(?string $element = null): string {}
        public function getManifest(): \SimpleXMLElement {}
        public function getName(): string {}
    }
    interface InstallerScriptInterface
    {
        public function install(InstallerAdapter $adapter): bool;
        public function update(InstallerAdapter $adapter): bool;
        public function uninstall(InstallerAdapter $adapter): bool;
        public function preflight(string $type, InstallerAdapter $adapter): bool;
        public function postflight(string $type, InstallerAdapter $adapter): bool;
    }
}

