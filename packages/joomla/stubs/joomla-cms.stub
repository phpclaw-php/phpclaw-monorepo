<?php

/**
 * PHPStan stub declarations for Joomla CMS runtime classes.
 * Joomla CMS is provided by the live installation - not available via Composer.
 * Registered via phpstan.neon scanFiles so PHPStan can resolve these types.
 */

namespace {
    const JPATH_ADMINISTRATOR = '';
    const JPATH_ROOT = '';
    const JPATH_SITE = '';
}

namespace Joomla\CMS\Application {
    abstract class CMSApplication
    {
        public function getDispatcher(): \Joomla\Event\DispatcherInterface {}
        public function getIdentity(): ?\Joomla\CMS\User\User {}
        public function getDocument(): \Joomla\CMS\Document\Document {}
        public function getContainer(): \Joomla\DI\Container {}
        public function getName(): string {}
        public function getInput(): mixed {}
        public function close(int $code = 0): void {}
        public function setHeader(string $name, string $value, bool $replace = true): void {}
        public function sendHeaders(): void {}
        public function getLanguage(): \Joomla\CMS\Language\Language {}
    }
    class ConsoleApplication extends CMSApplication
    {
        public function addCommand(\Joomla\Console\Command\AbstractCommand $command): void {}
    }
}

namespace Joomla\CMS\Plugin {
    abstract class CMSPlugin implements \Joomla\CMS\Extension\PluginInterface
    {
        /** @var \Joomla\Registry\Registry */
        protected $params;
        protected $autoloadLanguage = false;
        public function __construct(\Joomla\Event\DispatcherInterface $dispatcher, array $config = []) {}
        public function registerListeners() {}
        public function setApplication(\Joomla\CMS\Application\CMSApplication $application): void {}
        protected function getApplication(): ?\Joomla\CMS\Application\CMSApplication {}
    }
    class PluginHelper
    {
        /** @return object|false */
        public static function getPlugin(string $type, string $element): object|false {}
        public static function importPlugin(string $type, ?string $element = null, bool $strict = false, ?\Joomla\Event\DispatcherInterface $dispatcher = null): bool {}
    }
}

namespace Joomla\CMS\Form {
    class Form
    {
        public function getName(): string {}
        public function removeField(string $name, ?string $group = null): bool {}
        public function getXml(): \SimpleXMLElement {}
    }
    abstract class FormField
    {
        /** @var string */
        protected $type = '';
        protected function getOptions(): array {}
    }
}

namespace Joomla\CMS\Form\Field {
    abstract class ListField extends \Joomla\CMS\Form\FormField
    {
        protected function getOptions(): array {}
    }
}

namespace Joomla\CMS\MVC\Controller {
    abstract class BaseController
    {
        /** @var string */
        protected $default_view = '';
        public function display(bool $cachable = false, array $urlparams = []): static {}
        public function getModel(string $name = '', string $prefix = '', array $config = []): mixed {}
    }
}

namespace Joomla\CMS\MVC\View {
    abstract class HtmlView
    {
        public function display(?string $tpl = null): void {}
        public function getModel(string $name = ''): mixed {}
