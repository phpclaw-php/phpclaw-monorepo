        public function getDatabase(): \Joomla\Database\DatabaseInterface {}
    }
}

namespace Joomla\CMS\MVC\Factory {
    interface MVCFactoryInterface {}
    class MVCFactory implements MVCFactoryInterface {}
}

namespace Joomla\CMS\Extension {
    interface PluginInterface
    {
        public function registerListeners();
    }
    interface ComponentInterface
    {
        public function getDispatcher(\Joomla\CMS\Application\CMSApplication $application): \Joomla\Event\DispatcherInterface;
    }
    abstract class MVCComponent implements ComponentInterface
    {
        public function __construct(\Joomla\CMS\Dispatcher\ComponentDispatcherFactoryInterface $dispatcherFactory) {}
        public function getDispatcher(\Joomla\CMS\Application\CMSApplication $application): \Joomla\Event\DispatcherInterface {}
        public function setMVCFactory(\Joomla\CMS\MVC\Factory\MVCFactoryInterface $mvcFactory) {}
    }
    interface BootableExtensionInterface
    {
        public function boot(\Psr\Container\ContainerInterface $container): void;
    }
    class ExtensionHelper
    {
        /** @return object|false */
        public static function getExtensionRecord(string $element, string $type = 'component', int $clientId = 1, string $folder = ''): object|false {}
    }
}

namespace Joomla\CMS\Language {
    class Language
    {
        public function load(string $extension = 'joomla', string $basePath = '', ?string $lang = null, bool $reload = false, bool $default = true): bool {}
    }
    class Text
    {
        public static function _(string $string, bool $jsSafe = false, bool $interpreteBackSlashes = true): string {}
        public static function sprintf(string $string, mixed ...$args): string {}
    }
}

namespace Joomla\CMS {
    class Factory
    {
        public static ?\Joomla\CMS\Application\CMSApplication $application = null;
        public static function getApplication(): \Joomla\CMS\Application\CMSApplication {}
        public static function getContainer(): \Joomla\DI\Container {}
        public static function getCache(string $group = '', string $handler = 'callback', ?string $storage = null): object {}
        public static function getSession(): \Joomla\CMS\Session\Session {}
    }
}

